# --- Display ST7789 (SPI) ---
CONFIG_BSP_DISPLAY_ENABLED=y
CONFIG_BSP_DISPLAY_INTERFACE_SPI=y
CONFIG_BSP_DISPLAY_DRIVER_ST7789=y
CONFIG_BSP_DISPLAY_SCLK_GPIO=12
CONFIG_BSP_DISPLAY_MOSI_GPIO=11
CONFIG_BSP_DISPLAY_MISO_GPIO=-1
CONFIG_BSP_DISPLAY_CS_GPIO=10
CONFIG_BSP_DISPLAY_DC_GPIO=14
CONFIG_BSP_DISPLAY_RST_GPIO=15
CONFIG_BSP_DISPLAY_BACKLIGHT_GPIO=17
CONFIG_BSP_DISPLAY_COLOR_SPACE_RGB=y
# Adatta questi due alla risoluzione REALE del tuo pannello ST7789
# (i moduli comuni sono 240x240, 135x240 o 240x320 — il default del file è 320x240)
CONFIG_BSP_DISPLAY_WIDTH=320
CONFIG_BSP_DISPLAY_HEIGHT=240

# --- Audio I2S (DAC) ---
CONFIG_BSP_I2S_NUM=0
CONFIG_BSP_I2S_MCLK=-1
CONFIG_BSP_I2S_SCLK=7
CONFIG_BSP_I2S_LCLK=8
CONFIG_BSP_I2S_DOUT=9
CONFIG_BSP_I2S_DSIN=-1

# --- LED integrato (facoltativo) ---
CONFIG_BSP_LED_TYPE_RGB=y
CONFIG_BSP_LEDS_NUM=1
CONFIG_BSP_LED_RGB_GPIO=48

# --- Pulsanti (esempio: su / giù / sx / dx / fuoco) ---
CONFIG_BSP_BUTTONS_NUM=5
CONFIG_BSP_BUTTON_1_GPIO=4
CONFIG_BSP_BUTTON_1_LEVEL=0
CONFIG_BSP_BUTTON_2_GPIO=5
CONFIG_BSP_BUTTON_2_LEVEL=0
CONFIG_BSP_BUTTON_3_GPIO=6
CONFIG_BSP_BUTTON_3_LEVEL=0
CONFIG_BSP_BUTTON_4_GPIO=16
CONFIG_BSP_BUTTON_4_LEVEL=0
CONFIG_BSP_BUTTON_5_GPIO=18
CONFIG_BSP_BUTTON_5_LEVEL=0
